# =============================================================================
# Frontend / Vercel environment variables (Vite + React).
#
# VITE_* variables are exposed to the browser at build time — never put
# backend secrets here. Backend-only secrets (MongoDB credentials, LLM API
# keys, Firebase Admin SDK JSON, LinkedIn client secrets, GitHub tokens)
# belong in the backend / Railway .env.
# =============================================================================

# Backend API base URL.
# Local development: http://localhost:8000
# Production (Vercel frontend → Railway backend): https://<railway-app>.up.railway.app
VITE_API_BASE_URL=http://localhost:8000

# Firebase Web SDK — public configuration only (these values are meant to
# be in the browser). Safe to expose in VITE_* variables.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=