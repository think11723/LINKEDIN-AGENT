# Frontend (Vite) — Firebase Web SDK public configuration only.
# Never place backend secrets, MongoDB credentials, LLM API keys,
# Firebase Admin credentials, LinkedIn client secrets, or SMTP passwords
# here. VITE_* variables are exposed to the browser at build time.

VITE_API_BASE_URL=http://localhost:8000
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=