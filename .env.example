# =============================================================================
# Backend / Railway environment variables (Python / FastAPI).
# Frontend / Vercel variables live in frontend/.env.example — never put
# backend secrets here with VITE_* (they would be shipped to the browser).
# =============================================================================

# LLM Provider Configuration
# Provider Priority (fallback order)
PRIMARY_PROVIDER=groq
SECONDARY_PROVIDER=huggingface
TERTIARY_PROVIDER=openrouter

# Legacy support (maps到 PRIMARY_PROVIDER)
DEFAULT_PROVIDER=groq
LLM_TIMEOUT=120

# Hugging Face API (default provider)
HF_API_KEY=

# OpenRouter API
OPENROUTER_API_KEY=

# Groq API
GROQ_API_KEY=

# GitHub API (optional — for the URL-to-LinkedIn feature)
# Required only for higher rate limits; public repos work without a token.
# Unauthenticated: 60 requests/hour per IP.
# With a personal access token (PAT): up to 5000 requests/hour.
# Generate at https://github.com/settings/tokens (no special scopes needed for public repos).
GITHUB_TOKEN=

# Model Mappings (Groq - Primary)
PLANNER_MODEL_GROQ=llama-3.3-70b-versatile
WRITER_MODEL_GROQ=llama-3.3-70b-versatile
REVIEWER_MODEL_GROQ=deepseek-r1-distill-llama-70b
RESEARCH_MODEL_GROQ=deepseek-r1-distill-llama-70b

# Model Mappings (Hugging Face - Secondary)
PLANNER_MODEL_HF=mistralai/Mistral-7B-Instruct-v0.3
WRITER_MODEL_HF=mistralai/Mistral-7B-Instruct-v0.3
REVIEWER_MODEL_HF=deepseek-ai/DeepSeek-V3
RESEARCH_MODEL_HF=deepseek-ai/DeepSeek-V3

# Model Mappings (OpenRouter - Tertiary)
PLANNER_MODEL_OR=qwen/qwen-2.5-72b-instruct
WRITER_MODEL_OR=qwen/qwen-2.5-72b-instruct
REVIEWER_MODEL_OR=deepseek/deepseek-chat
RESEARCH_MODEL_OR=deepseek/deepseek-chat

# LinkedIn OAuth Configuration (for publishing)
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# In production: https://<railway-backend-domain>/api/v1/linkedin/callback
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/v1/linkedin/callback

# Approval System Configuration
APPROVAL_EXPIRY_HOURS=24
SERVER_URL=http://localhost:8000
MAX_PUBLISH_RETRIES=3
ENABLE_VERSIONING=true
ENABLE_AUDIT_LOG=true
AUTO_CLEANUP_EXPIRED=true
ENABLE_BACKGROUND_PUBLISH=true
MAX_DRAFT_VERSIONS=10
AUDIT_LOG_RETENTION_DAYS=30

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=your_email@gmail.com
EMAIL_TO=owner_email@gmail.com

# Image Generation Configuration
IMAGE_PROVIDER=pollinations
IMAGE_MODEL=flux
IMAGE_SIZE=1200x675
IMAGE_STYLE=professional
IMAGE_REQUIRED=false
IMAGE_RETRY_COUNT=3
ENABLE_IMAGE_GENERATION=true

# =============================================================================
# Phase 7 SaaS backend — placeholders only. No real values.
# =============================================================================

# MongoDB (required for the SaaS backend).
MONGODB_URI=
MONGODB_DB_NAME=linkedin_agent

# Firebase Admin SDK (server-side). Choose ONE of the two options.
# Option A: path to a service-account JSON file kept OUTSIDE the repo.
FIREBASE_CREDENTIALS_PATH=
# Option B: raw JSON content of the service account (escape newlines).
#   This is the path used in Railway (no local file).
FIREBASE_CREDENTIALS_JSON=
# Optional override; usually inferred from the credential.
FIREBASE_PROJECT_ID=

# CORS allow-list (comma-separated). In production on Railway, set this to
# the exact Vercel frontend origin (https://<vercel-app>.vercel.app).
# No wildcards. Localhost entries are kept so dev keeps working.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Phase 8C — LinkedIn OAuth callback redirects here so the SPA can
# pick up the ?linkedin=connected|error&reason=... flag in the URL.
# In production on Railway: https://<vercel-app>.vercel.app
FRONTEND_URL=http://localhost:5173

# Fernet key for encrypting LinkedIn access/refresh tokens at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LINKEDIN_TOKEN_ENCRYPTION_KEY=

# Source-job / URL-to-LinkedIn feature, Phase 8D. All backend-only.
# Defaults are safe in production; override only if you need different
# limits. SSRF_ALLOW_PRIVATE must remain false in production.
SOURCE_FETCH_MAX_BYTES=5242880
SOURCE_FETCH_MAX_REDIRECTS=5
SOURCE_FETCH_TIMEOUT_SECONDS=20
SOURCE_FETCH_TOTAL_TIMEOUT_SECONDS=90
SOURCE_GITHUB_MAX_BYTES=1048576
SOURCE_HTML_MAX_BYTES_AFTER_STRIP=1048576
SSRF_ALLOWED_PORTS=80,443
SSRF_ALLOW_PRIVATE=false
SOURCE_EXTRACTOR=trafilatura
SOURCE_JOBS_MAX_ACTIVE_PER_USER=3
SOURCE_JOBS_RATE_PER_HOUR=10
